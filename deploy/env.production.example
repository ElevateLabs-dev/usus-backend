# Production settings reference (on Render these are set per service — see render.yaml).
# Generate secrets with:        openssl rand -hex 32

PROJECT_NAME="Usus API"
ENVIRONMENT="production"
SECRET_KEY="CHANGE_ME_openssl_rand_hex_32"

# Database: Neon (https://neon.tech) — paste the connection string from the
# Neon console unchanged (postgresql://...?sslmode=require&channel_binding=require).
# The app adapts it for asyncpg. Migrations automatically use the direct
# (non "-pooler") endpoint.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

ADMIN_USERNAME="admin"
ADMIN_PASSWORD="CHANGE_ME"

# AI
LLM_PROVIDER="openai"
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4.1-mini"
LLM_TIMEOUT_SECONDS=60

# Domain for HTTPS (DNS A record must point at the server). Leave as :80 to test by IP.
SITE_ADDRESS=":80"

# ==========================================
# Email (trainee invites) via Resend – https://resend.com
# ==========================================
# Without RESEND_API_KEY, emails are only printed to the server log (local dev).
RESEND_API_KEY="re_..."
# Sender must be on a domain verified in Resend.
# For testing, "Usus <onboarding@resend.dev>" works but only delivers to your own Resend account email.
EMAIL_FROM="Usus <no-reply@yourdomain.com>"
# Frontend address used for the sign-in link in invite emails
FRONTEND_URL="https://app.yourdomain.com"
