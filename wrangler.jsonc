{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usus-api",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "UsusApi",
      "image": "./Dockerfile",
      // 1/4 vCPU, 1 GiB memory, 4 GB disk
      "instance_type": "basic",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "UsusApi", "name": "USUS_API" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsusApi"] }],
  // Plain settings. Keys and passwords are secrets: see docs/cloudflare-deploy.md
  "vars": {
    "ENVIRONMENT": "production",
    "RUN_MIGRATIONS": "true",
    "WEB_CONCURRENCY": "1",
    "LLM_PROVIDER": "openai",
    "OPENAI_MODEL": "gpt-4.1-mini",
    "LLM_TIMEOUT_SECONDS": "60"
  }
}
