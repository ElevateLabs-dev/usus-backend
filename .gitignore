*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/

# =========================
# Environments & Package Management (uv)
# =========================
# Ignore the actual virtual environment directory created by `uv`
.venv/
venv/
env/
ENV/

# NOTE: Do NOT ignore pyproject.toml or uv.lock! 
# They must be committed for deterministic builds.

# =========================
# Secrets & Environment Variables
# =========================
# Never commit your database URLs, Redis URIs, or API keys
.env
.env.*
!.env.example

# =========================
# Background Processing (Celery)
# =========================
celerybeat-schedule
celerybeat.pid
*.pid

