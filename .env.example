# ==========================================
# Core Application Settings
# ==========================================
PROJECT_NAME="Usus API"
ENVIRONMENT="local" # Options: local, staging, production
# Generate a secure key for production! (e.g., using `openssl rand -hex 32`)
SECRET_KEY="super-secret-development-key-change-in-production"

# ==========================================
# Database Configuration (SQLAlchemy / pgvector)
# ==========================================
# Format: postgresql+asyncpg://user:password@host:port/dbname
# This matches the credentials in our docker-compose.yml
# Option A – local Postgres from docker-compose.yml:
DATABASE_URL="postgresql+asyncpg://usus_admin:usus_local_password@localhost:5433/usus_dev_db"
# Option B – Neon: paste the connection string from the Neon console unchanged, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Tip: use a separate Neon *branch* for development so you never touch production data.

# ==========================================
# Redis & Celery (Background Tasks)
# ==========================================
# This matches the Redis container in our docker-compose.yml
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# ==========================================
# Admin Dashboard
# ==========================================
# Credentials for the Starlette-Admin panel at /admin
# Change these before deploying to any non-local environment!
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="changeme"

# ==========================================
# AI & LLM Providers
# ==========================================
# Usus is model-agnostic, but you'll need at least one key to test the simulation engine locally
# Which provider powers the AI customer + evaluator: openai | anthropic
LLM_PROVIDER="openai"
# Seconds before an LLM call is abandoned
LLM_TIMEOUT_SECONDS=60

OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_MODEL="gpt-4.1-mini"

ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key-here"
ANTHROPIC_MODEL="claude-haiku-4-5"

# ==========================================
# Email (trainee invites) via Resend – https://resend.com
# ==========================================
# Without RESEND_API_KEY, emails are only printed to the server log (local dev).
RESEND_API_KEY=""
# Sender must be on a domain verified in Resend.
# For testing, "Usus <onboarding@resend.dev>" works but only delivers to your own Resend account email.
EMAIL_FROM="Usus <no-reply@yourdomain.com>"
# Frontend address used for the sign-in link in invite emails
FRONTEND_URL="http://localhost:3000"

# ==========================================
# Cloud Storage (AWS S3 for Voice Recordings)
# ==========================================
# Required for saving WebRTC audio files asynchronously via aioboto3
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="usus-local-audio-recordings"
